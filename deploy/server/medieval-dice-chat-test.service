[Unit]
Description=Medieval Dice Chat Test Server
After=network-online.target

[Service]
Type=simple
User=medievaldice
WorkingDirectory=/opt/medieval-dice-chat-test
ExecStart=/opt/medieval-dice-chat-test/medieval_dice_server.x86_64 -- --port=9082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
